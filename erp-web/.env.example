# Copia este archivo como .env.local y ajústalo. .env.local no se versiona.

# Origen de la API. Es el valor por defecto; corresponde al perfil "http" de
# ERP.Api/Properties/launchSettings.json. Con docker compose, usa el 8080.
VITE_API_URL=http://localhost:5080

# Modo demo: los diez endpoints los responde un Service Worker (MSW) dentro del
# navegador, con datos equivalentes a la semilla de desarrollo. No necesita API
# ni SQL Server. Úsalo para publicar la consola o para trabajar sin backend.
VITE_MODO_DEMO=false

# Espejo de la sección "Ventas" de ERP.Api/appsettings.json. Solo afecta a la
# previsualización de totales mientras se arma una venta: el total que vale es
# el que calcula el dominio en el servidor.
VITE_TASA_IMPUESTO=0.19
VITE_PRECIO_INCLUYE_IMPUESTO=false
